# The SDK and ImageBuilder Docker image tags are derived from these values.
OPENWRT_VERSION=24.10.8
OPENWRT_TARGET=mediatek
OPENWRT_SUBTARGET=filogic

# Where the ImageBuilder and test containers download official packages.
# Point it at a closer mirror in config/local.env, which is not committed.
OPENWRT_MIRROR=https://downloads.openwrt.org
# shellcheck source=/dev/null # optional, machine-specific
if [ -f "${ROOT:-.}/config/local.env" ]; then . "${ROOT:-.}/config/local.env"; fi
