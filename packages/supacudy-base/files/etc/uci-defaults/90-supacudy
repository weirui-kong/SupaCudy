# Runs once on first boot (and after installing the package).

# The web UI talks to rpcd through uhttpd's /ubus endpoint.
if [ -z "$(uci -q get uhttpd.main.ubus_prefix)" ]; then
	uci set uhttpd.main.ubus_prefix='/ubus'
	uci commit uhttpd
fi

# https-dns-proxy switches all DNS to DoH as soon as it runs; it stays off
# until encrypted DNS is chosen in the UI.
if [ -x /etc/init.d/https-dns-proxy ] && [ "$(uci -q get supacudy.dns.mode)" != encrypted ]; then
	/etc/init.d/https-dns-proxy disable
fi

# Reaching the router from the WAN side: the web UI open, SSH closed. Kept
# as they are once they exist (the Settings page switches them).
for spec in 'webui:80 443:1:SupaCudy: web UI from the WAN' 'ssh:22:0:SupaCudy: SSH from the WAN'; do
	key=${spec%%:*}; rest=${spec#*:}
	ports=${rest%%:*}; rest=${rest#*:}
	enabled=${rest%%:*}; name=${rest#*:}
	section="supacudy_wan_$key"
	[ -n "$(uci -q get "firewall.$section")" ] && continue
	uci set "firewall.$section=rule"
	uci set "firewall.$section.name=$name"
	uci set "firewall.$section.src=wan"
	uci set "firewall.$section.proto=tcp"
	uci set "firewall.$section.dest_port=$ports"
	uci set "firewall.$section.target=ACCEPT"
	uci set "firewall.$section.enabled=$enabled"
	uci commit firewall
done

# Uplink priority by route metric: Ethernet, then repeater (20) and
# tethering (30), which the UI sets when it creates them. The failover
# watcher's own routes sit below all three.
[ -n "$(uci -q get network.wan.metric)" ] || { uci set network.wan.metric='10'; uci commit network; }

# The web UI logs in through /cgi-bin/supacudy-login, which logs the caller's
# address for the login protection. Anonymous session.login on /ubus would let
# password guessing go uncounted, so rpcd's ACL for anonymous callers keeps
# only "access". The file belongs to rpcd: a newer rpcd brings the original
# back until this runs again on the next first boot.
ACL=/usr/share/rpcd/acl.d/unauthenticated.json
if [ -f "$ACL" ] && grep -q '"login"' "$ACL"; then
	cat > "$ACL" <<-'EOF'
	{
		"unauthenticated": {
			"description": "Access controls for unauthenticated requests",
			"read": {
				"ubus": {
					"session": [
						"access"
					]
				}
			}
		}
	}
	EOF
	[ -x /etc/init.d/rpcd ] && /etc/init.d/rpcd reload
fi

# The tailscale package starts its daemon on install; it stays off until
# remote access is turned on in the UI.
if [ -x /etc/init.d/tailscale ] && [ "$(uci -q get supacudy.remote.tailscale)" != 1 ]; then
	/etc/init.d/tailscale disable
fi

exit 0
