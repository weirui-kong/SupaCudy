# Runs once on first boot (and after installing the package).

# The web UI talks to rpcd through uhttpd's /ubus endpoint.
if [ -z "$(uci -q get uhttpd.main.ubus_prefix)" ]; then
	uci set uhttpd.main.ubus_prefix='/ubus'
	uci commit uhttpd
fi

exit 0
