# Rescue mode watcher, see /usr/libexec/supacudy/rescue.uc. Starting fresh
# on every boot is what keeps rescue mode from outliving the problem.

# shellcheck disable=SC2034 # read by rc.common
START=99
# shellcheck disable=SC2034 # read by rc.common
USE_PROCD=1

start_service() {
	rm -f /var/run/supacudy/rescue.json
	procd_open_instance
	procd_set_param command /usr/libexec/supacudy/rescue-watch
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

stop_service() {
	ucode /usr/libexec/supacudy/rescue.uc stop
}
