# Switches the repeater to another saved network when the current one is
# lost; the decision itself is made by supacudy.repeater_tick.

# shellcheck disable=SC2034 # read by rc.common
START=99
# shellcheck disable=SC2034 # read by rc.common
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/supacudy/repeater-watch
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
