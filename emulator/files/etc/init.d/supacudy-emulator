#!/bin/sh /etc/rc.common
# Copyright 2026 SupaCudy contributors
# SPDX-License-Identifier: Apache-2.0
#
# Builds the world around the emulated router, each actor in its own
# network namespace on this VM:
#
#   upstream  phy3: "Hotel-WiFi" (WPA2), "Cafe-Free" (open) and "Campus-WiFi"
#             (WPA2-Enterprise, PEAP or TTLS as campus-user / campus-pass,
#             server certificate emu-server) hotspots with DHCP, routed to the internet through veth-uplink; a DNS server
#             on 10.250.10.2 that knows vpn-test.example (10.250.30.7); a
#             WireGuard server ("VPN provider") on 10.250.10.2:51820 and an
#             OpenVPN server on 10.250.10.2:1194 (tunnel 10.250.31.0/24)
#   phone     phy2: a Wi-Fi client of the router's 2.4 GHz network
#   visitor   phy4: joins the guest network "SupaCudy-Guest" (password
#             guest-pass-1) whenever one with that name exists
#   laptop    wired LAN client on br-lan
#   nas       wired LAN client on br-lan
#
# phy0 and phy1 stay with the router as its 2.4 GHz and 5 GHz radios.

# shellcheck disable=SC2034 # read by rc.common
START=99
# shellcheck disable=SC2034 # read by rc.common
USE_PROCD=1

LIB=/usr/libexec/supacudy-emulator
RUN=/var/run/supacudy-emulator

ROUTER_SSID='SupaCudy-Emu'
ROUTER_KEY='supacudy-wifi'
HOTEL_SSID='Hotel-WiFi'
HOTEL_KEY='hotel-guest'
CAFE_SSID='Cafe-Free'
CAMPUS_SSID='Campus-WiFi'
CAMPUS_USER='campus-user'
CAMPUS_PASS='campus-pass'
GUEST_SSID='SupaCudy-Guest'
GUEST_KEY='guest-pass-1'
# Test-only keys, published in docs/emulator.md; never use them elsewhere.
VPN_SERVER_KEY='+Gb6D8AumHBmmcI/kZ40HOkWkIyy+GYl/a2C9XwZcls='
VPN_CLIENT_PUB='XdLB/OQnZ4OXQxwH8gFgHgdN4eTU+P5nEMFDMGjEpB0='
VPN_PSK='irMdu0PKEDRBjbj/oi0azFqXoQ6PlS7h9dY2NMRHFp8='

log() {
	logger -t supacudy-emulator "$*"
}

in_ns() {
	ns="$1"
	shift
	ip netns exec "$ns" "$@"
}

ensure_ns() {
	ip netns list | grep -qw "$1" || ip netns add "$1"
	mkdir -p "/etc/netns/$1"
	# ip netns exec bind-mounts this over /etc/resolv.conf in the namespace.
	[ -f "/etc/netns/$1/resolv.conf" ] || : > "/etc/netns/$1/resolv.conf"
	in_ns "$1" ip link set lo up
}

move_phy() {
	phy="$1"
	ns="$2"
	ifname="$3"
	if [ -d "/sys/class/ieee80211/$phy" ]; then
		iw phy "$phy" set netns name "$ns"
	fi
	in_ns "$ns" iw dev "$ifname" info >/dev/null 2>&1 ||
		in_ns "$ns" iw phy "$phy" interface add "$ifname" type managed
}

configure_router_wifi() {
	[ "$(uci -q get wireless.radio0.supacudy_emulator)" = 1 ] && return
	[ -s /etc/config/wireless ] || wifi config

	uci -q batch <<-EOF
		set wireless.radio0.band='2g'
		set wireless.radio0.channel='6'
		set wireless.radio0.htmode='HT20'
		set wireless.radio0.disabled='0'
		set wireless.radio0.supacudy_emulator='1'
		set wireless.default_radio0.ssid='$ROUTER_SSID'
		set wireless.default_radio0.encryption='psk2'
		set wireless.default_radio0.key='$ROUTER_KEY'
		set wireless.radio1.band='5g'
		set wireless.radio1.channel='36'
		set wireless.radio1.htmode='HT20'
		set wireless.radio1.disabled='0'
		set wireless.default_radio1.ssid='$ROUTER_SSID-5G'
		set wireless.default_radio1.encryption='psk2'
		set wireless.default_radio1.key='$ROUTER_KEY'
		delete wireless.radio2
		delete wireless.default_radio2
		delete wireless.radio3
		delete wireless.default_radio3
		delete wireless.radio4
		delete wireless.default_radio4
		commit wireless
	EOF
	wifi reload
}

setup_upstream() {
	ensure_ns upstream
	move_phy phy3 upstream up0

	if ! ip link show veth-uplink >/dev/null 2>&1; then
		ip link add veth-uplink type veth peer name uplink0 netns upstream
		ip link set veth-uplink up
		# netifd (network.emu_uplink) addresses it once the device exists;
		# the firewall zone matches the device by name, so reload it too.
		ifup emu_uplink
		/etc/init.d/firewall reload
	fi

	in_ns upstream ip addr replace 10.250.10.2/30 dev uplink0
	in_ns upstream ip link set uplink0 up
	in_ns upstream ip route replace default via 10.250.10.1
	in_ns upstream sysctl -qw net.ipv4.ip_forward=1
	in_ns upstream nft -f - <<-EOF
		table ip emu_nat
		delete table ip emu_nat
		table ip emu_nat {
			chain post {
				type nat hook postrouting priority 100;
				oifname "uplink0" masquerade
			}
		}
	EOF

	setup_vpn_server

	mkdir -p "$RUN"
	cat > "$RUN/hostapd-upstream.conf" <<-EOF
		interface=up0
		driver=nl80211
		ctrl_interface=$RUN/hostapd
		hw_mode=g
		channel=1
		ssid=$HOTEL_SSID
		wpa=2
		wpa_key_mgmt=WPA-PSK
		rsn_pairwise=CCMP
		wpa_passphrase=$HOTEL_KEY
		bss=up1
		ssid=$CAFE_SSID
		bss=up2
		ssid=$CAMPUS_SSID
		wpa=2
		wpa_key_mgmt=WPA-EAP
		rsn_pairwise=CCMP
		ieee8021x=1
		eap_server=1
		eap_user_file=$RUN/hostapd-eap.users
		ca_cert=$OVPN/ca.crt
		server_cert=$OVPN/server.crt
		private_key=$OVPN/server.key
	EOF
	# Phase 1 for anyone, then the one inner login.
	cat > "$RUN/hostapd-eap.users" <<-EOF
		* PEAP,TTLS
		"$CAMPUS_USER" MSCHAPV2,GTC,TTLS-MSCHAPV2,TTLS-PAP "$CAMPUS_PASS" [2]
	EOF
}

# Tunnel 10.250.30.0/24; decrypted traffic leaves through uplink0 and is
# masqueraded like the hotspot guests.
setup_vpn_server() {
	command -v wg >/dev/null || return 0
	mkdir -p "$RUN"
	umask 077
	echo "$VPN_SERVER_KEY" > "$RUN/wg-server.key"
	echo "$VPN_PSK" > "$RUN/wg-server.psk"
	umask 022
	in_ns upstream ip link show wg0 >/dev/null 2>&1 || in_ns upstream ip link add wg0 type wireguard
	in_ns upstream wg set wg0 private-key "$RUN/wg-server.key" listen-port 51820 \
		peer "$VPN_CLIENT_PUB" preshared-key "$RUN/wg-server.psk" allowed-ips 10.250.30.2/32
	in_ns upstream ip addr replace 10.250.30.1/24 dev wg0
	in_ns upstream ip link set wg0 up
}

# Test-only certificates in $OVPN, see docs/emulator.md.
OVPN=/usr/share/supacudy-emulator/openvpn

setup_ovpn_server() {
	command -v openvpn >/dev/null || return 1
	mkdir -p "$RUN"
	cat > "$RUN/openvpn-server.conf" <<-EOF
		dev ovpns
		dev-type tun
		proto udp
		port 1194
		topology subnet
		server 10.250.31.0 255.255.255.0
		ca $OVPN/ca.crt
		cert $OVPN/server.crt
		key $OVPN/server.key
		dh none
		keepalive 5 20
		push "dhcp-option DNS 10.250.31.1"
		verb 1
	EOF
}

setup_phone() {
	ensure_ns phone
	move_phy phy2 phone ph0
	mkdir -p "$RUN"
	cat > "$RUN/wpa-phone.conf" <<-EOF
		ctrl_interface=$RUN/wpa-phone
		network={
			ssid="$ROUTER_SSID"
			psk="$ROUTER_KEY"
		}
	EOF
}

setup_visitor() {
	ensure_ns visitor
	move_phy phy4 visitor vi0
	mkdir -p "$RUN"
	cat > "$RUN/wpa-visitor.conf" <<-EOF
		ctrl_interface=$RUN/wpa-visitor
		network={
			ssid="$GUEST_SSID"
			psk="$GUEST_KEY"
		}
	EOF
}

setup_wired() {
	name="$1"
	mac="$2"
	ensure_ns "$name"
	if ! ip link show "veth-$name" >/dev/null 2>&1; then
		ip link add "veth-$name" type veth peer name eth0 netns "$name"
		in_ns "$name" ip link set eth0 address "$mac"
	fi
	ip link set "veth-$name" master br-lan
	ip link set "veth-$name" up
	in_ns "$name" ip link set eth0 up
}

instance() {
	name="$1"
	shift
	procd_open_instance "$name"
	procd_set_param command "$@"
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	log "building the emulated network"
	configure_router_wifi
	setup_upstream
	setup_phone
	setup_visitor
	setup_wired laptop 02:5c:00:00:00:11
	setup_wired nas 02:5c:00:00:00:12

	instance upstream-hostapd ip netns exec upstream hostapd "$RUN/hostapd-upstream.conf"
	instance upstream-dhcp ip netns exec upstream dnsmasq --keep-in-foreground \
		--conf-file=/dev/null --bind-dynamic --interface=up0 --interface=up1 --interface=up2 --interface=uplink0 \
		--address=/vpn-test.example/10.250.30.7 \
		--except-interface=lo --dhcp-range=up0,10.250.11.100,10.250.11.199,1h \
		--dhcp-range=up1,10.250.12.100,10.250.12.199,1h --dhcp-range=up2,10.250.13.100,10.250.13.199,1h --no-resolv --server=10.250.2.3 \
		--pid-file="$RUN/dnsmasq-upstream.pid" --dhcp-leasefile="$RUN/dnsmasq-upstream.leases"
	instance upstream-addr "$LIB/upstream-addresses"
	if setup_ovpn_server; then
		instance upstream-openvpn ip netns exec upstream openvpn --config "$RUN/openvpn-server.conf"
	fi

	instance phone-wpa ip netns exec phone wpa_supplicant -i ph0 -c "$RUN/wpa-phone.conf"
	instance phone-dhcp ip netns exec phone udhcpc -f -i ph0 -x hostname:Pixel-Phone -s "$LIB/udhcpc.script"
	instance phone-traffic ip netns exec phone "$LIB/traffic" 3

	instance visitor-wpa ip netns exec visitor wpa_supplicant -i vi0 -c "$RUN/wpa-visitor.conf"
	instance visitor-dhcp ip netns exec visitor udhcpc -f -i vi0 -x hostname:Guest-Tablet -s "$LIB/udhcpc.script"

	instance laptop-dhcp ip netns exec laptop udhcpc -f -i eth0 -x hostname:Work-Laptop -s "$LIB/udhcpc.script"
	instance laptop-traffic ip netns exec laptop "$LIB/traffic" 1
	instance nas-dhcp ip netns exec nas udhcpc -f -i eth0 -x hostname:Home-NAS -s "$LIB/udhcpc.script"
}

stop_service() {
	for ns in upstream phone visitor laptop nas; do
		ip netns del "$ns" 2>/dev/null
	done
	ip link del veth-uplink 2>/dev/null
	true
}
